page 2 (
    name: Validation
    alias: VALIDATION
    title: Validation
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region VALIDATION_IG (
        name: Details
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       NAME,
                       LOCATION
                  from DEMO
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        advanced {
            htmlDomId: VALIDATION_IG
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 15325798845301982
        }

        savedReport primary (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
                }
            )

            displayColumn (
                column: @ID
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @NAME
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @LOCATION
                layout {
                    sequence: 3
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column ID (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: ID
                dataType: number
                queryOnly: true
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column LOCATION (
            type: textField
            heading {
                heading: Location
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            validation {
                maxLength: 300
            }
            source {
                databaseColumn: LOCATION
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        column NAME (
            type: textField
            heading {
                heading: Name
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            validation {
                maxLength: 400
            }
            source {
                databaseColumn: NAME
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
    )

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    dynamicAction new_1 (
        name: New
        execution {
            sequence: 20
        }
        when {
            selectionType: columns
            interactiveGrid: @VALIDATION_IG
            columns: NAME
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var region = apex.region("VALIDATION_IG");
                    
                    if (!region) {
                        console.error("VALIDATION_IG not found");
                        return;
                    }
                    
                    var ig$ = region.widget();
                    var gridView = ig$.interactiveGrid("getViews", "grid");
                    var grid$ = gridView.view$;
                    var model = gridView.model;
                    
                    
                    var currentName = this.triggeringElement.value;
                    
                    console.log("CURRENT INPUT VALUE:", currentName);
                    
                    if (currentName == null) {
                        return;
                    }
                    
                    currentName = String(currentName).trim().toUpperCase();
                    
                    if (currentName === "") {
                        return;
                    }
                    
                    
                    var currentRecordId = grid$.grid("getActiveRecordId");
                    
                    console.log("CURRENT RECORD ID:", currentRecordId);
                    
                    if (!currentRecordId) {
                        console.log("CURRENT RECORD ID NOT FOUND");
                        return;
                    }
                    
                    var duplicate = false;
                    
                    model.forEach(function(record, index, recordId) {
                    
                    
                        if (String(recordId) === String(currentRecordId)) {
                            return;
                        }
                    
                        var name = model.getValue(record, "NAME");
                    
                        console.log(
                            "ROW:",
                            name,
                            "ID:",
                            recordId
                        );
                    
                        if (
                            name != null &&
                            String(name).trim().toUpperCase() === currentName
                        ) {
                            duplicate = true;
                        }
                    });
                    
                    console.log("DUPLICATE:", duplicate);
                    
                    
                    if (duplicate) {
                    
                        apex.message.clearErrors();
                    
                        apex.message.showErrors([
                            {
                                type: "error",
                                location: "page",
                                message: "Duplicate NAME is not allowed.",
                                unsafe: false
                            }
                        ]);
                    
                     
                        var item = apex.item(this.triggeringElement);
                    
                        item.setValue("", null, true);
                    
                       
                        grid$.grid("setActiveRecordValue", "NAME");
                    
                        console.log("DUPLICATE CLEARED");
                    
                    } else {
                    
                        console.log("NAME IS UNIQUE");
                    }
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation new (
        name: CHECK_DUBLICATE_NAMES
        execution {
            sequence: 10
        }
        validation {
            editableRegion: @VALIDATION_IG
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                
                
                DECLARE
                    v_dup_in_db     NUMBER := 0;
                    v_dup_in_batch  NUMBER := 0;
                BEGIN
                    
                    SELECT COUNT(*)
                      INTO v_dup_in_db
                      FROM demo d
                     WHERE upper(d.name) = upper(:NAME)
                       AND NVL(d.id, -1) != NVL(:ID, -1);
                
                    IF v_dup_in_db > 0 THEN
                        RETURN 'This name already exists in the database.';
                    END IF;
                
                   
                    SELECT COUNT(*)
                      INTO v_dup_in_batch
                      FROM apex_collections
                     WHERE collection_name = 'MY_COLLECTION'
                       AND UPPER(c001) = UPPER(:NAME);
                
                    IF v_dup_in_batch > 0 THEN
                        RETURN 'Duplicate name entered in this same save. Please use unique names.';
                    END IF;
                
                    
                    apex_collection.add_member(
                        p_collection_name => 'MY_COLLECTION',
                        p_c001            => :NAME
                    );
                
                    RETURN NULL;
                EXCEPTION
                    WHEN OTHERS THEN
                        RETURN 'Validation error: ' || SQLERRM;
                END;
                ```
            alwaysExecute: true
        }
        error {
            associatedColumn: NAME
        }
        config {
            buildOption: @commented-out
        }
    )

    process create-collection (
        name: create_collection
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    IF NOT apex_collection.collection_exists('MY_COLLECTION') THEN
                        apex_collection.create_collection_from_query(
                            p_collection_name => 'MY_COLLECTION',
                            p_query           => 'SELECT id, name, location FROM demo'
                        );
                    END IF;
                END;
                
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 15331452326317902
        }
    )

    process new (
        name: New
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    l_count NUMBER;
                    l_name  VARCHAR2(4000);
                BEGIN
                
                    IF apex_collection.collection_exists('MY_COLLECTION') THEN
                        apex_collection.truncate_collection('MY_COLLECTION');
                    ELSE
                        apex_collection.create_collection('MY_COLLECTION');
                    END IF;
                
                
                    FOR r IN (
                        SELECT name
                        FROM demo
                    )
                    LOOP
                        l_name := UPPER(TRIM(r.name));
                
                        SELECT COUNT(*)
                          INTO l_count
                          FROM apex_collections
                         WHERE collection_name = 'MY_COLLECTION'
                           AND UPPER(TRIM(c001)) = l_name;
                
                        IF l_count > 0 THEN
                            raise_application_error(
                                -20001,
                                'Duplicate NAME "' || r.name || '" is not allowed.'
                            );
                        END IF;
                
                        apex_collection.add_member(
                            p_collection_name => 'MY_COLLECTION',
                            p_c001            => r.name
                        );
                    END LOOP;
                
                END;
                
                
                
                
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 15331744538317905
        }
        config {
            buildOption: @commented-out
        }
    )

    process validation-save-interactive-grid-data (
        name: Validation - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @VALIDATION_IG
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 15330347143302025
        }
    )

)

