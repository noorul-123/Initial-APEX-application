page 4 (
    name: Details
    alias: DETAILS
    title: Details
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region details (
        name: Details
        type: form
        source {
            location: localDatabase
            tableName: CICD_MIGRATIONS
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P4_EXECUTED_BY (
        type: textField
        label {
            label: Executed By
            alignment: right
        }
        layout {
            sequence: 40
            region: @details
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 100
        }
        source {
            formRegion: @details
            column: EXECUTED_BY
            dataType: varchar2
        }
    )

    pageItem P4_EXECUTED_ON (
        type: datePicker
        label {
            label: Executed On
            alignment: right
        }
        layout {
            sequence: 30
            region: @details
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @details
            column: EXECUTED_ON
            dataType: timestamp
        }
    )

    pageItem P4_SCRIPT_NAME (
        type: textField
        label {
            label: Script Name
            alignment: right
        }
        layout {
            sequence: 20
            region: @details
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 255
        }
        source {
            formRegion: @details
            column: SCRIPT_NAME
            dataType: varchar2
        }
    )

    pageItem P4_VERSION (
        type: textField
        label {
            label: New
            alignment: left
        }
        layout {
            sequence: 10
            region: @details
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            formRegion: @details
            column: VERSION
            dataType: varchar2
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @details
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @details
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P4_VERSION
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @details
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P4_VERSION
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @details
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P4_VERSION
        }
    )

    validation p4-executed-on-must-be-timestamp (
        name: P4_EXECUTED_ON must be timestamp
        execution {
            sequence: 20
        }
        validation {
            type: itemIsAValidTimestamp
            item: P4_EXECUTED_ON
        }
        error {
            errorMessage: #LABEL# must be a valid timestamp.
            associatedItem: @P4_EXECUTED_ON
        }
    )

    process initialize-form-details (
        name: Initialize form Details
        type: formInitialization
        formRegion: @details
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 22489652026114104
        }
    )

    process process-form-details (
        name: Process form Details
        type: formAutoRowProcessing
        formRegion: @details
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 22490041226114107
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 1
            }
        }
    )

)

